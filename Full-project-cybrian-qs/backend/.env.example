# Copy to backend/.env before running Docker or local uvicorn. Values here are placeholders.

JWT_SECRET_KEY=replace-with-long-random-string
JWT_REFRESH_SECRET_KEY=replace-with-different-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Docker Compose overrides DB host and Qdrant URL; keep these for local dev if needed.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=editor_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/editor_db
DATABASE_URL_LOCAL=postgresql://postgres:postgres@localhost:5433/editor_db
DATABASE_URL_DOCKER=postgresql://postgres:postgres@db:5432/editor_db

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM / provider keys (set at least one for full AI features)
GEMINI_API_KEY=
OPENAI_API_KEY=
