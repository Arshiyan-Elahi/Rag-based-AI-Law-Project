# Copy to ".env" next to docker-compose.yml (same folder) so Compose can substitute variables.
# Use a strong POSTGRES_PASSWORD in production; if it contains @ : / etc., URL-encode it for DATABASE_URL or avoid those characters.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=editor_db

# Host port for the nginx frontend (backend stays internal)
HTTP_PORT=80

# In-stack Qdrant (defaults match docker-compose.yml). Override if using external Qdrant.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
